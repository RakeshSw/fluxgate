{
  "manifest_version": 3,
  "name": "FluxGate",
  "version": "1.0.0",
  "description": "Isolated-browser JSON response override tool for authorized testing.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluxGate"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
