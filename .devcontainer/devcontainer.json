{
  "name": "FluxGate development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "FluxGate private browser",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "docker compose config --quiet"
}
